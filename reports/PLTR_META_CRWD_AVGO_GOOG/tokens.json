{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Offline editorial research magazine with source-bound financial calculations.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "hex": "#000000"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.271,
          0.271,
          0.271
        ],
        "hex": "#454545"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.773,
          0
        ],
        "hex": "#ffc500"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.992,
          0.988,
          0.953
        ],
        "hex": "#fdfcf3"
      }
    },
    "rule": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.851,
          0.851,
          0.851
        ],
        "hex": "#d9d9d9"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "section": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Georgia",
        "fontSize": {
          "value": 64,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": -0.04,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Georgia",
        "fontSize": {
          "value": 18,
          "unit": "px"
        },
        "fontWeight": 400
      }
    },
    "label-caps": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Arial",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.05,
          "unit": "em"
        }
      }
    }
  }
}
